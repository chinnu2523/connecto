<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Outer Rounded Square Background with Neon Green -> Cyan -> Blue Gradient -->
    <path
        android:pathData="M 30,12 L 70,12 A 18,18 0 0,1 88,30 L 88,70 A 18,18 0 0,1 70,88 L 30,88 A 18,18 0 0,1 12,70 L 12,30 A 18,18 0 0,1 30,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="84"
                android:endY="84"
                android:type="linear">
                <item android:color="#FF00F5A0" android:offset="0.0"/>
                <item android:color="#FF00D9F5" android:offset="0.5"/>
                <item android:color="#FF2563EB" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vertical Pill (Frosted White Translucent) -->
    <path
        android:pathData="M 50,23 A 11,11 0 0,1 61,34 L 61,66 A 11,11 0 0,1 39,66 L 39,34 A 11,11 0 0,1 50,23 Z"
        android:fillColor="#B3FFFFFF"/>

    <!-- Horizontal Pill (Frosted White Translucent) -->
    <path
        android:pathData="M 34,39 L 66,39 A 11,11 0 0,1 66,61 L 34,61 A 11,11 0 0,1 34,39 Z"
        android:fillColor="#B3FFFFFF"/>

    <!-- Center Glowing White Circle -->
    <path
        android:pathData="M 50,50 m -10,0 a 10,10 0 1,0 20,0 a 10,10 0 1,0 -20,0"
        android:fillColor="#FFFFFFFF"/>

</vector>
