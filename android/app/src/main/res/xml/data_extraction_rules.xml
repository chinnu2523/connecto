<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- SEC-A4-06 FIX: Block sensitive session tokens and SQLite chat caches from cloud backup and D2D transfers -->
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
