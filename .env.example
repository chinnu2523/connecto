# =============================================================================
# Connecto Environment Variables Configuration Template
# Copy this file to .env and configure with secure random secrets
# WARNING: NEVER commit the actual .env file or real secrets to git!
# =============================================================================

# Server Environment
CONNECTO_ENV=production
ENV=production

# Application Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key_here

# Administrative Passcode (For hardware passkey / admin console)
ADMIN_PASSCODE=replace_with_a_strong_random_admin_passcode_here

# Telegram Security & Alert Dispatcher (Bot token obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_CHANNEL=@your_official_channel
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id

# Cloudflare D1 Native Edge Database Gateway
D1_ENABLED=true
D1_DATABASE_NAME=connecto-db
D1_DATABASE_ID=c95366cb-6dde-4bfe-8a3e-f466969f1a16
D1_ENDPOINT=https://connecto.fun/api/v1/db/query
D1_HEALTH_ENDPOINT=https://connecto.fun/api/v1/db/health
DB_API_KEY=replace_with_a_secure_d1_api_secret_key

# Carrier Email / SMS Providers (Optional production gateways)
RESEND_API_KEY=
MSG91_AUTH_KEY=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
